RAG_CORPUS_DIR=pdfs
RAG_INDEX_PATH=.rag/index.json
RAG_MANIFEST_PATH=.rag/manifest.sqlite
RAG_EXTRACTION_CACHE_DIR=.rag/extracted
RAG_CHUNK_SIZE_CHARS=1400
RAG_CHUNK_OVERLAP_CHARS=220
RAG_TOP_K=5
RAG_PDF_WORKERS=1
RAG_EMBED_BATCH_SIZE=64
RAG_EMBEDDING_BACKEND=auto
# Remote embedding backend examples:
# RAG_EMBEDDING_BACKEND=remote
# RAG_EMBEDDING_SERVICE_URL=http://gpu-host:8100
# RAG_EMBEDDING_SERVICE_TIMEOUT_SECONDS=60
# RAG_EMBEDDING_SERVICE_TOKEN=
# RAG_EMBEDDING_SERVICE_EXPECTED_MODEL=sentence-transformers:BAAI/bge-base-en-v1.5
# RAG_REMOTE_EMBED_BATCH_SIZE=64
# RAG_EMBEDDING_SERVICE_MAX_BATCH_SIZE=256
# RAG_EMBEDDING_SERVICE_MAX_TEXT_CHARS=20000
RAG_GENERATION_BACKEND=extractive
RAG_ANSWER_MODE=patient
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_OLLAMA_GENERATION_MODEL=llama3.1
RAG_API_BASE_URL=https://api.openai.com/v1
RAG_API_KEY=
RAG_API_GENERATION_MODEL=gpt-4o-mini
RAG_API_EMBEDDING_MODEL=text-embedding-3-small
RAG_API_MAX_OUTPUT_TOKENS=800
RAG_API_REASONING_EFFORT=
RAG_API_MAX_RETRIES=2
RAG_TEMPERATURE=0.1
RAG_REQUEST_TIMEOUT_SECONDS=120
# Docker compose: host directory for Qdrant storage (default: qdrant_data named volume)
# QDRANT_DATA_DIR=/mnt/qdrant
# Docker compose: Qdrant WAL segment size in MB; lower on slow disks (upstream default 32)
# QDRANT_WAL_CAPACITY_MB=8
# Clerk sign-in (https://dashboard.clerk.com -> API keys). The patient view and /ask are
# public; the developer workbench (/dev) and its API need a signed-in user whose public
# metadata contains {"admin": true}.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: PEM public key from the dashboard, to verify session tokens without fetching JWKS.
# CLERK_JWT_KEY=
# Required with a production (pk_live_) key: comma-separated origins of this app's pages
# (the token's azp claim). Optional with development (pk_test_) keys.
# CLERK_AUTHORIZED_PARTIES=https://stroke.example.org
# Local development and tests only: open the developer workbench to everyone.
# RAG_AUTH_DISABLED=false
