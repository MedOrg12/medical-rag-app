FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-hpc.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-hpc.txt

COPY medical_rag/ ./medical_rag/

ENV PYTHONUNBUFFERED=1 \
    RAG_SENTENCE_TRANSFORMERS_DEVICE=cuda \
    HF_HOME=/data/huggingface

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8100/health || exit 1

CMD ["uvicorn", "medical_rag.embedding_server:app", "--host", "0.0.0.0", "--port", "8100", "--workers", "1"]
